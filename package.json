{
  "name": "collab-editor",
  "private": true,
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "scripts": {
    "test:crdt": "npm run test --workspace=packages/crdt",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "db:migrate": "psql \"$DATABASE_URL\" -f server/src/schema.sql"
  }
}
