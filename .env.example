# Copy this file to .env and fill in your values.
# The server reads these at startup via dotenv.

# Postgres — matches docker-compose.yml (port 5433 because local Windows Postgres
# already occupies 5432; the container maps 5433→5432 internally)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/collab_editor

# Redis — matches docker-compose.yml
REDIS_URL=redis://localhost:6379

# JWT signing secret — change this before any real deployment
JWT_SECRET=dev-secret-change-me

# HTTP port for the Express + Socket.io server
PORT=4000
